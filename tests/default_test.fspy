lk.
declare A,B,C:bool.
declare rule : (A->B).
declare ax : (A).
deny elur: (A-C).
deny mox: (C).

# Should succeed:
theorem delegation_test : (B).
prove delegation_test.
cut (A->B) alpha.
axiom rule.
elim.
by default.
axiom ax.
axiom alpha.
qed.

#Should succeed:
antitheorem delegation_test : (A).
refute delegation_test.
cut (A-C) x.
elim.
by default.
moxia mox.
axiom x.
moxia elur.
qed.

# Should succeed:
argument delegation_test : (B).
cut (A->B) alpha.
axiom rule.
elim.
by default.
next.
axiom alpha.
dixi.
render delegation_test vanilla.
render delegation_test argumentation.

#Should succeed:
counterargument delegation_counter_test : (: (A)).
cut (A-C) x.
elim.
by default.
axiom x.
moxia elur.
dixi.
render delegation_counter_test vanilla.


# Should fail:
theorem delegation_test_2 : (B).
prove delegation_test_2.
cut (A->B) alpha.
axiom rule.
elim.
by default.
next.
axiom alpha.
qed.