lk.
declare A,B,C:bool.
declare rule : (A->B).
declare ax : (A).
deny elur: (A-C).
deny mox: (C).

# Should succeed:
theorem delegation_test : (B).
prove delegation_test.
cut (A->B) alpha.
axiom rule.
elim.
by default.
axiom ax.
axiom alpha.
qed.

#Should succeed:
antitheorem delegation_test2 : (A).
refute delegation_test2.
cut (A-C) x.
elim.
by default.
moxia mox.
axiom x.
moxia elur.
qed.

# Should succeed:
argument delegation_test3 : (B).
cut (A->B) alpha.
axiom rule.
elim.
by default.
next.
axiom alpha.
dixi.
render delegation_test3 vanilla.
render delegation_test3 argumentation.

#Should succeed:
counterargument delegation_counter_test : (A).
cut (A-C) x.
elim.
by default.
next.
axiom x.
moxia elur.
dixi.
render delegation_counter_test vanilla.


# Should fail:
theorem delegation_test_4 : (B).
prove delegation_test_4.
cut (A->B) alpha.
axiom rule.
elim.
by default.
next.
axiom alpha.
qed.