# First-order Peirce as a debate (tasks.org, aida-discourse-referents).
# a asks, under forall z, for Dr z -> false, owed under Dr z's
# continuation g: the open site is the referent statement Dr ?z -> false.
# sup states it for the referent ?x; filling a's site, ?x stands for z,
# and sup's own presumed site (Dr ?x)⊥, now (Dr z)⊥, is captured by g.
lk.
# Referents are instantiated on the unfolded route only, for now.
pipeline unfolded.
declare Pub : type.
declare Dr : Pub -> bool.
argument a : (forall z:Pub, ((Dr [z] -> false) -> Dr [z]) -> Dr [z]).
elim z.
elim f.
cut ((Dr [z] -> false) -> Dr [z]) g.
axiom f.
elim.
next.
axiom g.
dixi.
argument sup : (Dr [?x] -> false).
elim p.
cut (Dr [?x]) m.
axiom p.
by default.
dixi.
