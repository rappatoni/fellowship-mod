# The drinker paradox as a debate that presumes nothing classical
# (tasks.org, aida-discourse-referents): drinker_closed.fspy with its
# presumed Peirce replaced by first-order Peirce argued with the referent
# argument sup. a normalises to the classical proof of fo_t_drinker.fsp.
lk.
# Referents are instantiated on the unfolded route only, for now.
pipeline unfolded.
declare Pub : type.
declare c : Pub.
declare Dr : Pub -> bool.
# peirce: first-order Peirce as a debate - its open site Dr z -> false
# is the referent statement sup states.
argument peirce : (forall z:Pub, ((Dr [z] -> false) -> Dr [z]) -> Dr [z]).
elim z.
elim f.
cut ((Dr [z] -> false) -> Dr [z]) g.
axiom f.
elim.
next.
axiom g.
dixi.
argument sup : (Dr [?x] -> false).
elim p.
cut (Dr [?x]) m.
axiom p.
by default.
dixi.
# b: a non-drinker is a witness (ex falso).
argument b : (forall z:Pub, (Dr [z] -> false) -> (exists x:Pub, Dr [x] -> (forall y:Pub, Dr [y]))).
elim z.
elim n.
elim [z].
elim d.
cut (Dr [z] -> false) g.
axiom n.
elim.
axiom d.
elim.
dixi.
# a: witness c; for an arbitrary y, Dr y by Peirce: assuming not Dr y,
# offer the claim again by b at y.
argument a : (exists x:Pub, Dr [x] -> (forall y:Pub, Dr [y])).
elim [c].
elim h.
elim y.
cut (forall z:Pub, ((Dr [z] -> false) -> Dr [z]) -> Dr [z]) p.
next.
elim [y].
elim.
elim n.
cut (exists x:Pub, Dr [x] -> (forall y:Pub, Dr [y])) k.
cut (forall z:Pub, (Dr [z] -> false) -> (exists x:Pub, Dr [x] -> (forall y:Pub, Dr [y]))) l.
next.
elim [y].
elim.
axiom n.
axiom l.
next.
axiom p.
dixi.
