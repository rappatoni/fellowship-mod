# Two pronouns (tasks.org, aida-referents-anaphora; after the author's
# tests/anaphora/multiple_dynamic.fspy, 2026-10-23). "A farmer has a
# donkey. He bites it." he_bites_him chooses ?c and ?d, one inside the
# other's pair; each has its own witness scaffold, and both try the
# farmer !a and the donkey !b. Bare, both take the latest antecedent and
# the donkey bites itself. he_bites_it owes farmer ?c and donkey ?d,
# which only the right antecedent meets, so the farmer bites the donkey.
lk.
pipeline unfolded.
declare iota : type.
declare farmer, donkey : iota -> bool.
declare has, bites : iota -> iota -> bool.
argument a_farmer_has_a_donkey : [!a:iota, !b:iota] exists x:iota, exists y:iota, farmer [x] - ~donkey [y] - ~has [x] [y].
elim [!a].
elim [!b].
elim.
elim.
by default.
next.
elim.
elim.
by default.
next.
by default.
dixi.
argument he_bites_him : [?c:iota, ?d:iota] exists x:iota, exists y:iota, bites [x] [y].
elim [?c].
elim [?d].
by default.
dixi.
argument he_bites_it : [?c:iota, ?d:iota] exists x:iota, exists y:iota, farmer [x] - ~donkey [y] - ~bites [x] [y].
elim [?c].
elim [?d].
elim.
elim.
by default.
next.
elim.
elim.
next.
next.
dixi.
