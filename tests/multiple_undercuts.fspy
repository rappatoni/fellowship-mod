# Testing grafting and reduction of a debate with multiple undercuts attacking the same assumption.

lk.

declare A,B,C,D:bool.
declare r1: (A -> B).
declare r2: (B -> ~A).
declare r3: (C -> ~A).
declare r4: (D -> ~A).
#
# Attacked argument:
#
start argument arg1 B
cut (A -> B) th.
axiom r1.
elim.
next.
axiom.
end argument
#
#Undercutter 1
#
start counterargument counter1 A
cut (~A) x.
cut (B -> ~A) th.
axiom r2.
elim.
next.
axiom.
elim.
axiom.
end argument
#
#Undercutter 2
#
start counterargument counter2 A
cut (~A) x.
cut (C -> ~A) th.
axiom r3.
elim.
next.
axiom.
elim.
axiom.
end argument
#
#Undercutter 3
#
start counterargument counter3 A
cut (~A) x.
cut (D -> ~A) th.
axiom r4.
elim.
next.
axiom.
elim.
axiom.
end argument
#
#Constructing undercuts, reducing coloring, building trees.
debate pro open first : B.
arg1.
rebut counter1 arg1.
hora est.
evaluate first
label first
tree first
debate pro open second : B.
arg1.
rebut counter1 arg1.
rebut counter2 arg1.
hora est.
evaluate second
label second
tree second
debate pro open third : B.
arg1.
rebut counter1 arg1.
rebut counter2 arg1.
rebut counter3 arg1.
hora est.
#
#Reduce, color and construct tree
#
evaluate third
label third
tree third nl