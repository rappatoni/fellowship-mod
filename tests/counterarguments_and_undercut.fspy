# This script tests counterarguments and undercut.

lk.

# First we declare our running example:
#
declare EfficientMetro, StrikeMetro, UseMetro, DealMetro, LowballOffer : bool.
declare r1: (EfficientMetro -> UseMetro).
declare r2: (StrikeMetro -> ~EfficientMetro).
#
# Then an argument to use the metro.
#
argument arg1 : (UseMetro).
cut (EfficientMetro -> UseMetro) th.
axiom r1.
elim.
next.
axiom.
dixi.
#
# Next, a counterargument
#
counterargument arg2 : (EfficientMetro).

cut (~EfficientMetro) x.
cut (StrikeMetro -> ~EfficientMetro) th.
axiom r2.
elim.
next.
axiom.
elim.
axiom.
dixi.
#
# Now we test if arg2 undercuts arg1 on EfficientMetro as intended: 
#
debate pro open u1 : UseMetro.
arg1.
rebut arg2 arg1.
cedat tempus.
#
# Next, we reduce the resulting argument to confirm that arg1 is defeated and color it.
evaluate u1.
label u1.
#
#We add an attacker to the counterargument to test that the original conclusion is restored as intended.
#
#
declare r3: (DealMetro -> ~StrikeMetro).
#
counterargument arg3 : (StrikeMetro).
cut (~StrikeMetro) x.
cut (DealMetro -> ~StrikeMetro) th.
axiom r3.
elim.
next.
axiom.
elim.
axiom.
dixi.
#
# Introduce the attacker, normalize and color:
debate pro open u2 : UseMetro.
arg1.
rebut arg2 arg1.
rebut arg3 arg2.
cedat tempus.
evaluate u2.
label u2.
#
# And one last undercut
#
declare r4: (LowballOffer -> ~DealMetro).
#
counterargument arg4 : (DealMetro).
cut (~DealMetro) x.
cut (LowballOffer -> ~DealMetro) th.
axiom r4.
elim.
next.
axiom.
elim.
axiom.
dixi.
#
# Introduce the attacker, normalize and color:
debate pro open u3 : UseMetro.
arg1.
rebut arg2 arg1.
rebut arg3 arg2.
rebut arg4 arg3.
cedat tempus.
evaluate u3.
label u3.
tree u3 nl.
#
# Now we test an undercut on a laog assumption
#
declare BadNegotiations : bool.
deny r5: (LowballOffer - BadNegotiations).
counterargument arg5 : (LowballOffer).
cut (LowballOffer - BadNegotiations) th.
elim.
next.
axiom th.
moxia r5.
dixi.
#
# Undercutter
#
declare NoCoffee : bool.
declare r6 : (NoCoffee -> BadNegotiations).
argument arg6 : (BadNegotiations).
cut (NoCoffee -> BadNegotiations) th.
axiom r6.
elim.
next.
axiom.
dixi.
# Constructing undercut
debate con open u4 : LowballOffer.
arg5.
rebut arg6 arg5.
cedat tempus.
# Reduce, color
evaluate u4.
render u4 vanilla.
label u4.