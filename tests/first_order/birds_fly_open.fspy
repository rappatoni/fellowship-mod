# The same argument owing the open formula Wings x under the binder: it
# owes the referent statement Wings ?x, which an argument stating it
# fills (tasks.org, aida-discourse-referents; before, Q2 refused it).
lk.
declare Animal : type.
declare Bird, Wings, Flies : Animal -> bool.
declare wf : (forall x:Animal, Wings [x] -> Flies [x]).
argument birds_fly : (forall x:Animal, Bird [x] -> Flies [x]).
elim.
elim b.
cut (forall x:Animal, Wings [x] -> Flies [x]) r.
axiom wf.
elim [x].
elim.
next.
axiom r.
dixi.
