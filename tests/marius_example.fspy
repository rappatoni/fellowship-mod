lk.

declare A,A_h,B,C,D:bool.

declare f : (B -> A).
declare f_h : (A_h -> A).
deny alpha : (A_h-C).
deny beta : (A_h-D).

# First in one go:
argument arg0 : (A).
cut (A) alt. 
cut (A) _.
cut (B -> A) h.
axiom f.
elim.
next.
axiom.
axiom alt. 
cut (A) _.
cut (A_h -> A) h.
axiom f_h.
elim.
cut (A_h) att.
cut (A_h) _.
next.
axiom att.
cut (A_h) _.
next.
cut (A_h) alt_h.
cut (A_h) _.
axiom alt_h.
cut (A_h - C) att1.
elim.
next.
axiom att1.
moxia alpha.
cut (A_h) _.
axiom alt_h.
cut (A_h - D) att2.
elim.
next.
axiom att2.
moxia beta.
axiom h.
axiom.
dixi.
render arg1 vanilla.
render arg1.

#Then via argument operations:

argument arg1 : (A).
cut (A_h -> A) h.
axiom f_h.
elim.
next.
axiom.
dixi.

argument sup1 : (A).
cut (B -> A) h.
axiom f.
elim.
next.
axiom.
dixi.

counterargument counter1 : (A_h).
cut (A_h - C) att.
elim.
next.
axiom.
moxia alpha.
dixi.

counterargument counter2 : (A_h).
cut (A_h - D) att.
elim.
next.
axiom.
moxia beta.
dixi.

debate pro open first : A.
sup1.
support arg1 sup1.
cedat tempus.
debate con open second : A_h.
counter2.
support counter1 counter2.
cedat tempus.
debate pro open third : A.
sup1.
support arg1 sup1.
rebut counter2 arg1.
support counter1 counter2.
cedat tempus.

render third vanilla.
label third.