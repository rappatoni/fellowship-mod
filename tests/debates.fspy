# Debates (tasks.org, aida-debate-objects): named, ordered selections of a
# document's arguments, compiled on demand and never part of the document.
lk.
declare Bird, Penguin, Flies, Photo, Sings : bool.
declare bird : (Bird).
declare penguins_dont_fly : (Penguin -> ~Flies).
declare photos_show : (Photo -> ~Penguin).
# tweety: Tweety flies, being a bird - birds fly, by default.
start argument tweety Flies
cut (Bird -> Flies) birds_fly.
by default.
next.
elim.
axiom bird.
axiom birds_fly.
end argument
# penguin: Tweety does not fly - it is a penguin, presumed.
start counterargument penguin Flies
cut (Penguin -> ~Flies) rule.
axiom penguins_dont_fly.
elim.
by default.
next.
elim.
axiom.
end counterargument
# photo: it is not a penguin - a photo shows it, presumed.
start counterargument photo Penguin
cut (Photo -> ~Penguin) rule.
axiom photos_show.
elim.
by default.
next.
elim.
axiom.
end counterargument
# Something unrelated.
start argument sings Sings
by default.
end argument
