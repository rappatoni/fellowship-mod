# Testing the alternative arguments debate operation and reduction.

lk.

declare A,B,C,D:bool.
declare r1: (A -> B).
declare r2: (C -> A).
declare r3: (D -> A).
#
# Supported Argument
#
argument arg1 : (B).
cut (A -> B) th.
axiom r1.
elim.
cut (C -> A) bla.
axiom r2.
elim.
next.
axiom.
dixi.
#
# Supporter
#
argument sup1 : (A).
cut (D -> A) th.
axiom r3.
elim.
next.
axiom.
dixi.
#
# Construct support, reduce, color.
debate pro open first : B.
arg1.
% :A is arg1's lemma, an exposed node since 2026-10-16 (tasks.org,
% aida-rational-closure), so `support` reaches it.
support sup1 arg1.
cedat tempus.
evaluate first.
label first.
#
#Next we try alternative counterarguments:
#
deny r4: (B - A).
deny r5: (A - C).
deny r6: (A - D).
#
# Supported Counterargument
#
counterargument c1 : (B).
cut (B - A) th.
elim.
cut (A - C) bla.
elim.
next.
axiom bla.
moxia r5.
axiom th.
moxia r4.
dixi.
#
# Supporter
#
counterargument csup1 : (A).
cut (A - D) th.
elim.
next.
axiom th.
moxia r6.
dixi.
#
# Construct support, reduce, color.
debate con open second : B.
c1.
% A: is c1's lemma, an exposed node since 2026-10-16 (tasks.org,
% aida-rational-closure), so `support` reaches it.
support csup1 c1.
cedat tempus.
evaluate second.
label second.
#
#Testing admal
declare r7: (A - D).
% Refused at `dixi.` since 2026-10-15: the lambda-bar body uses the outer
% continuation th, so the argument is not linear (the pure level,
% tasks.org aida-argument-lj-restriction); eliminating a difference on the
% term side is classical.  Kept as the fixture of that refusal
% (tests/test_discipline.py).
argument admaltest : (A).
cut (A-D) th.
axiom r7.
elim alpha.
axiom th.
dixi.
#
#Supporting arg1
#
debate pro open third : B.
arg1.
% was `admaltest arg1.`: admaltest is refused above and so not registered.
cedat tempus.