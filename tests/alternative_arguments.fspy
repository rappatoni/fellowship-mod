# Testing the alternative arguments debate operation and reduction.

lk.

declare A,B,C,D:bool.
declare r1: (A -> B).
declare r2: (C -> A).
declare r3: (D -> A).
#
# Supported Argument
#
argument arg1 : (B).
cut (A -> B) th.
axiom r1.
elim.
cut (C -> A) bla.
axiom r2.
elim.
next.
axiom.
dixi.
#
# Supporter
#
argument sup1 : (A).
cut (D -> A) th.
axiom r3.
elim.
next.
axiom.
dixi.
#
# Construct support, reduce, color.
debate pro open first : B.
arg1.
% was `support sup1 arg1.`: :A is not a node of 'arg1' yet (an intermediate
% conclusion; tasks.org, aida-rational-closure), so the move carries no verb.
sup1 arg1.
cedat tempus.
evaluate first.
label first.
#
#Next we try alternative counterarguments:
#
deny r4: (B - A).
deny r5: (A - C).
deny r6: (A - D).
#
# Supported Counterargument
#
counterargument c1 : (B).
cut (B - A) th.
elim.
cut (A - C) bla.
elim.
next.
axiom bla.
moxia r5.
axiom th.
moxia r4.
dixi.
#
# Supporter
#
counterargument csup1 : (A).
cut (A - D) th.
elim.
next.
axiom th.
moxia r6.
dixi.
#
# Construct support, reduce, color.
debate con open second : B.
c1.
% was `support csup1 c1.`: A: is not a node of 'c1' yet (an intermediate
% conclusion; tasks.org, aida-rational-closure), so the move carries no verb.
csup1 c1.
cedat tempus.
evaluate second.
label second.
#
#Testing admal
declare r7: (A - D).
argument admaltest : (A).
cut (A-D) th.
axiom r7.
elim alpha.
axiom th.
dixi.
#
#Supporting arg1
#
debate pro open third : B.
arg1.
% was `support admaltest arg1.`: :A is not a node of 'arg1' yet (an intermediate
% conclusion; tasks.org, aida-rational-closure), so the move carries no verb.
admaltest arg1.
cedat tempus.