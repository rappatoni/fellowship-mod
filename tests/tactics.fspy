lk.

# This document specifies a bunch of theorems that can be converted into helpful tactics.

declare A,B,C : bool.

start argument implication_elimination B
cut (A->B) H.
next.
elim.
next.
axiom.

end argument

# A -> \bar{B}, \bar{B} -> A connective definitions.

start counterargument mixed_impl B
cut (false) x.
cut (B->false) y.
cut (A->B->false) z.
next.
elim.
next.
axiom.
elim.
axiom.
axiom.
elim.
end counterargument
