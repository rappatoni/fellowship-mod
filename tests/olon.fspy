# This script exercises odd loops over negation (olons) and positive loops.
lk.
declare A,B,C:bool.
declare rule1 : (B -> A).
deny rule2 : (B - C).
declare rule3 : (A -> C).
declare rule4: (A -> C -> false).

argument first : (A).
cut (B->A) rule.
axiom rule1.
elim.
by default.
next.
axiom.
dixi.

counterargument second : (B).
cut (B-C) rule.
elim.
by default.
next.
axiom.
moxia rule2.
dixi.

argument third : (C).
cut (A->C) rule.
axiom rule3.
elim.
by default.
next.
axiom.
dixi.

# This is an example of a positive loop: A can defend itself against C by counter attacking.
debate pro open intermediate : A.
first.
attack second first.
cedat tempus.
debate pro open final : A.
first.
attack second first.
attack third second.
cedat tempus.
# But we want to prevent infinite loops where first is now again introduced as a supporter for third. How to do this?


counterargument olonMaker : (C).
cut (A->C->false) rule.
axiom rule4.
elim.
by default.
next.
elim.
axiom.
elim.
dixi.

register olonMaker2 : C := "μ'test:C.<test:C||μ'rule:C.<rule4:A->C->false||!1.2.1:A*rule:C*_F_>>".
# register test : C := μ'olon_maker:C.<olon_maker:C||μ'rule:C.<rule4:A->C->false||1.2.1:A!*rule:C*_F_>>

counterargument neg_tester : (~A).
elim.
dixi.

deny elur1: (true - A - B).
argument tester : (A).
cut (true - A - B) elur.
elim.
by default.
next.
elim.
axiom.
elim.
moxia elur1.
dixi.

register tester2 : A := "μtester:A.<μelur:A.<1.1.1:B!*elur:A*_T_||elur1:(true-A)-B>||tester:A>".

debate pro open olon : A.
first.
attack second first.
support olonMaker second.
cedat tempus.
