# ================================================================
#  AC/DC demo 3 - the Nixon diamond: witness labellings, credulous, skeptical
# ================================================================
lk.
declare Quaker, Republican, Pacifist : bool.
declare quaker : (Quaker).
declare republican : (Republican).
# nixonQ: Nixon is a pacifist - he is a Quaker, and Quakers are pacifists (by default).
start argument nixonQ Pacifist
cut (Quaker -> Pacifist) quakers_pacifist.
by default.
next.
elim.
axiom quaker.
axiom quakers_pacifist.
end argument
# nixonR: Nixon is NOT a pacifist - he is a Republican, and Republicans are not (by default).
start counterargument nixonR Pacifist
cut (Republican -> ~Pacifist) republicans_hawks.
by default.
next.
elim.
axiom republican.
elim.
axiom.
end counterargument
%stop
# ---- paste from here ----------------------------------------------------
# Two presumed rules, head to head.  Grounded semantics leaves it undecided:
label nixonQ
# Preferred semantics offers two labellings, one per side of the contest:
label nixonQ preferred
# Skeptical evaluation takes what all labellings agree on - and the site stays
# open.  Credulous evaluation picks a labelling that accepts pacifism: a VALUE.
evaluate nixonQ skeptical
evaluate nixonQ credulous
# Which witness?  Number 1 by default; a number picks another; `all` lists
# every accepting one.  Labelling 2 rejects pacifism, so it is refused.
evaluate nixonQ credulous all
evaluate nixonQ credulous 2
# The diamond is symmetric: the same from Nixon the Republican's side.
label nixonR preferred
evaluate nixonR credulous
