# ================================================================
#  AC/DC demo 2 - support and attack: Tweety the penguin
# ================================================================
lk.
declare Bird, Penguin, Flies, Wings : bool.
declare bird : (Bird).
declare penguins_are_birds : (Penguin -> Bird).
declare penguins_dont_fly : (Penguin -> ~Flies).
declare winged_things_fly : (Wings -> Flies).
# tweety: Tweety flies, being a bird, since birds fly - by default.
argument tweety : (Flies).
cut (Bird -> Flies) birds_fly.
by default.
next.
elim.
axiom bird.
axiom birds_fly.
dixi.
# wings: Tweety flies because it has wings - if it has wings, which is owed.
argument wings : (Flies).
cut (Wings -> Flies) rule.
axiom winged_things_fly.
elim.
next.
axiom rule.
dixi.
# penguin: Tweety does not fly - it is a penguin.  Presumed.
counterargument penguin : (Flies).
cut (Penguin -> ~Flies) rule.
axiom penguins_dont_fly.
elim.
by default.
next.
elim.
axiom.
dixi.
# Something unrelated, to show the verbs check their target.
declare Sings : bool.
argument sings : (Sings).
by default.
dixi.
%stop
# ---- paste from here ----------------------------------------------------
# The document already holds every conflict: proposition identity is global.
graph document.
# A debate names a selection of the document's arguments; its verbs CHECK
# each move: a supporter must conclude a site of its target, an attacker the
# contrary of one.  An open debate hears the whole document.
debate pro open dsup : Flies.
tweety.
support wings tweety.
cedat tempus.
debate pro open datt : Flies.
tweety.
attack penguin tweety.
cedat tempus.
debate pro open bad : Flies.
tweety.
support sings tweety.
cedat tempus.
# The debate about Flies: supported by wings, contested by penguin.
graph tweety show.
label tweety.
# wings rests on an obligation nobody meets, so it is OUT.  The presumed rule
# "birds fly" and the presumed "it is a penguin" contest each other: UNDEC.
# The modes decide the contest.
evaluate tweety skeptical.
evaluate tweety credulous.
