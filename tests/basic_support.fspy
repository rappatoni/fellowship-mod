# Testing basic support debate operation and reduction.

lk.

declare A,B,C,D:bool.
declare r1: (A -> B).
declare r2: (C -> A).
#
# Supported Argument
#
argument arg1 : (B).
cut (A -> B) th.
axiom r1.
elim.
next.
axiom.
dixi.
#
# Supporter
#
argument sup1 : (A).
cut (C -> A) th.
axiom r2.
elim.
next.
axiom.
dixi.
#
# Construct support, reduce, color.
debate pro open first : B.
arg1.
support sup1 arg1.
cedat tempus.
render first vanilla.
evaluate first.
label first.
#
# Now we test a defeated supporter
#
declare r3: (D -> ~C).
counterargument counter : (C).
cut (~C) x.
cut (D -> ~C) th.
axiom r3.
elim.
next.
axiom.
elim.
axiom.
dixi.
#
# Applying undercut to debate "first"
#
debate pro open second : B.
arg1.
support sup1 arg1.
rebut counter sup1.
cedat tempus.
#
# Render, reduce, color
render second vanilla.
evaluate second.
label second.