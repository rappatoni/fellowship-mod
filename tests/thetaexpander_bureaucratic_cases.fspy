lk.
declare P,Q:bool.

argument atomic_term : (P).
dixi.

counterargument atomic_context : (P).
dixi.

argument affine_parent : (P).
cut (P) _.
dixi.

argument support_shell : (P).
dixi.

argument supporter : (P).
dixi.


argument term_under_mutilde : (P).
cut (P) beta.
dixi.

counterargument context_under_mu : (P).
cut (P) alpha.
dixi.


argument eta_long_parent : (P).
cut ((P->Q)->P) alpha.
elim g.
dixi.

argument lambda_parent : (((P->Q)->P)->P).
elim f.
dixi.


render atomic_term vanilla.
render atomic_context vanilla.
render affine_parent vanilla.
render eta_long_parent vanilla.
