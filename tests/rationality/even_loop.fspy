lj.

# Rationality fixture: even attack loop of length 2.
# P rests on the default absence of Q; Q rests on the default absence of P.
# Expected labellings (graph labeller, see README.org):
#   grounded:  P UNDEC, Q UNDEC
#   preferred: two labellings - {P IN, Q OUT} and {P OUT, Q IN}
#   credulous evaluation of issue P: value; skeptical: suspended focus.

declare P,Q:bool.
declare pRule : ((Q->false)->P).
declare qRule : ((P->false)->Q).

# argument Pdefault derives P from geled Q
start argument Pdefault P
cut ((Q->false)->P) rule.
axiom pRule.
elim.
elim h.
cut (Q) alpha.
axiom h.
by default.
next.
axiom.
end argument

# argument Qdefault derives Q from geled P
start argument Qdefault Q
cut ((P->false)->Q) rule.
axiom qRule.
elim.
elim h.
cut (P) alpha.
axiom h.
by default.
next.
axiom.
end argument

% D0 (2026-09-16): each argument alone is acyclic (P[t] <- Q[c]:pres and
% Q[t] <- P[c]:pres); the even loop only exists in the document graph of
% both, which compile_document now compiles instead of refusing
% (tests/test_debate_graph_integration.py): grounded all UNDEC, three
% stable labellings (the refutations are presumptions, so "both stand" is one).
% Under lj the term-side scaffolds unfolding builds are not LJ proof
% terms (they throw to a second conclusion), so the Fellowship replay
% that guards graph/label/evaluate refuses them.  Switched off here so
% the graph and labels can still be shown; tests/test_unfold.py carries
% the strict xfail (task aida-lj-unfolding).
typecheck off
graph Pdefault
label Pdefault
graph Qdefault
label Qdefault
