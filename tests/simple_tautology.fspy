lk.
declare A,B:bool.

# P1 : A -> B -> A
# S1: A! B -> A?
# P2: B -> A!
# S2: B! A?
# P3: A! A? -|
# S2': B -> A:!
# P3': B? A:?
# S3': B!
# P3': A:?
# S4': A:!
# P4': A! A:! -| 

argument p1 : (A -> B -> A).
dixi.

argument s1 : (A -> B -> A).
elim x.
dixi.

debate pro open d1 : A -> B -> A.
p1.
reinforce s1 p1.
cedat tempus.

argument p2 : (B -> A).
cut ( B -> A ) alpha.
dixi.

argument s2 : (B -> A).
elim y.
dixi.

argument p3 : (A).
cut (A) gamma.
dixi.

counterargument s2alt : (B -> A).
dixi.

counterargument p3alt : (B -> A).
elim.
dixi.

argument s4alt : (B).
cut B gamma.
next.
elim.
dixi.

argument p4alt : (B).
cut A iota.
dixi.

# Use here x:A

argument s5alt : (A).
cut A iota.
dixi.


