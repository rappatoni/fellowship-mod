next.
axiom r.
dixi.
# ozzy by the animal rule
counterargument f_animal_ozzy : (Fly [ozzy]).
cut (Fly [ozzy] -> false) n.
cut (forall x:Thing, Animal [x] -> (Ab1 [x] -> false) -> Fly [x] -> false) r.
axiom r_animal.
elim [ozzy].
elim.
cut (forall x:Thing, Bird [x] -> Animal [x]) s.
axiom birds_animals.
elim [ozzy].
elim.
cut (forall x:Thing, Ostrich [x] -> Bird [x]) s2.
axiom ostriches_birds.
elim [ozzy].
elim.
axiom ostrich_ozzy.
axiom s2.
axiom s.
elim.
elim h.
cut (Ab1 [ozzy]) k.
axiom h.
