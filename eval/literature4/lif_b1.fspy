next.
axiom r.
elim.
axiom.
elim.
dixi.
argument ab1_tweety : (Ab1 [tweety]).
cut (forall x:Thing, Bird [x] -> Ab1 [x]) r.
axiom bird_ab1.
elim [tweety].
elim.
axiom bird_tweety.
axiom r.
dixi.
argument ab1_bruce : (Ab1 [bruce]).
cut (forall x:Thing, Bat [x] -> Ab1 [x]) r.
axiom bat_ab1.
