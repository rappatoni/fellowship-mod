argument ab1_ozzy : (Ab1 [ozzy]).
cut (forall x:Thing, Bird [x] -> Ab1 [x]) r.
axiom bird_ab1.
elim [ozzy].
elim.
cut (forall x:Thing, Ostrich [x] -> Bird [x]) s.
