cut (Fly [bruce] -> false) n.
cut (forall x:Thing, Animal [x] -> (Ab1 [x] -> false) -> Fly [x] -> false) r.
axiom r_animal.
elim [bruce].
elim.
cut (forall x:Thing, Bat [x] -> Animal [x]) s.
axiom bats_animals.
elim [bruce].
elim.
axiom bat_bruce.
axiom s.
elim.
elim h.
cut (Ab1 [bruce]) k.
axiom h.
by default.
next.
axiom r.
elim.
axiom.
elim.
dixi.
# bruce by the bat rule
argument f_bat_bruce : (Fly [bruce]).
cut (forall x:Thing, Bat [x] -> (Ab3 [x] -> false) -> Fly [x]) r.
axiom r_bat.
elim [bruce].
elim.
axiom bat_bruce.
elim.
elim h.
cut (Ab3 [bruce]) k.
axiom h.
