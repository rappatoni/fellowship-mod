cut (Fly [ozzy] -> false) n.
cut (forall x:Thing, Ostrich [x] -> (Ab4 [x] -> false) -> Fly [x] -> false) r.
axiom r_ostrich.
elim [ozzy].
elim.
axiom ostrich_ozzy.
elim.
elim h.
cut (Ab4 [ozzy]) k.
axiom h.
