argument f_bird_tweety : (Fly [tweety]).
cut (forall x:Thing, Bird [x] -> (Ab2 [x] -> false) -> Fly [x]) r.
axiom r_bird.
elim [tweety].
elim.
axiom bird_tweety.
elim.
elim h.
cut (Ab2 [tweety]) k.
axiom h.
by default.
next.
axiom r.
dixi.
