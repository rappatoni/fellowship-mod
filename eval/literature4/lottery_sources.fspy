# The lottery paradox (Kyburg 1961), three tickets, exactly one wins.
# Pollock (collective defeat): for no ticket is "it loses" justified.
# Prakken (2016, "Rethinking the rationality postulates"): each "ticket i
# loses" is skeptically justified, "exactly one wins" too, and the argument
# Ai (the others lose, so i wins) is defeated. Here "ticket i loses" is
# derived from a presumed source (the statistical argument for each
# ticket), so that the two directions are both derivations.
lk.
declare T1, T2, T3, S1, S2, S3 : bool.
declare stat1 : (S1 -> T1 -> false).
declare stat2 : (S2 -> T2 -> false).
declare stat3 : (S3 -> T3 -> false).
declare one1 : ((T2 -> false) -> (T3 -> false) -> T1).
declare one2 : ((T1 -> false) -> (T3 -> false) -> T2).
declare one3 : ((T1 -> false) -> (T2 -> false) -> T3).
counterargument lose1 : (T1).
cut (S1 -> T1 -> false) r.
axiom stat1.
elim.
by default.
next.
elim.
axiom.
elim.
dixi.
counterargument lose2 : (T2).
cut (S2 -> T2 -> false) r.
axiom stat2.
elim.
by default.
next.
elim.
axiom.
elim.
dixi.
counterargument lose3 : (T3).
cut (S3 -> T3 -> false) r.
axiom stat3.
elim.
by default.
next.
elim.
axiom.
elim.
dixi.
argument a1 : (T1).
cut ((T2 -> false) -> (T3 -> false) -> T1) r.
axiom one1.
elim.
elim h.
cut (T2) k.
axiom h.
next.
elim.
elim h2.
cut (T3) k2.
axiom h2.
next.
axiom r.
dixi.
argument a2 : (T2).
cut ((T1 -> false) -> (T3 -> false) -> T2) r.
axiom one2.
elim.
elim h.
cut (T1) k.
axiom h.
next.
elim.
elim h2.
cut (T3) k2.
axiom h2.
next.
axiom r.
dixi.
argument a3 : (T3).
cut ((T1 -> false) -> (T2 -> false) -> T3) r.
axiom one3.
elim.
elim h.
cut (T1) k.
axiom h.
next.
elim.
elim h2.
cut (T2) k2.
axiom h2.
next.
axiom r.
dixi.
