# EquivalenceExample.java (theory1): arguments a, b, c; attacks a->b, b->c
lk.
declare A, B, C : bool.
declare att_a_b : (A -> ~B).
declare att_b_c : (B -> ~C).
argument a : (A).
by default.
dixi.
argument b : (B).
by default.
dixi.
argument c : (C).
by default.
dixi.
counterargument a_on_b : (B).
cut (~B) x.
cut (A -> ~B) th.
axiom att_a_b.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument b_on_c : (C).
cut (~C) x.
cut (B -> ~C) th.
axiom att_b_c.
elim.
next.
axiom.
elim.
axiom.
dixi.
