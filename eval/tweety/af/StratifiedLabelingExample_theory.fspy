# StratifiedLabelingExample.java (theory): arguments a, b, c, d; attacks a->b, b->a, b->c, c->b, c->d, d->c
lk.
declare A, B, C, D : bool.
declare att_a_b : (A -> ~B).
declare att_b_a : (B -> ~A).
declare att_b_c : (B -> ~C).
declare att_c_b : (C -> ~B).
declare att_c_d : (C -> ~D).
declare att_d_c : (D -> ~C).
argument a : (A).
by default.
dixi.
argument b : (B).
by default.
dixi.
argument c : (C).
by default.
dixi.
argument d : (D).
by default.
dixi.
counterargument a_on_b : (B).
cut (~B) x.
cut (A -> ~B) th.
axiom att_a_b.
elim.
next.
axiom.
elim.
axiom.
