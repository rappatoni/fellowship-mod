# LearningExample.java (dt): arguments b, c, d; attacks b->c, c->d, d->c
lk.
declare B, C, D : bool.
declare att_b_c : (B -> ~C).
declare att_c_d : (C -> ~D).
declare att_d_c : (D -> ~C).
argument b : (B).
by default.
dixi.
argument c : (C).
by default.
dixi.
argument d : (D).
by default.
dixi.
counterargument b_on_c : (C).
cut (~C) x.
cut (B -> ~C) th.
axiom att_b_c.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument c_on_d : (D).
cut (~D) x.
cut (C -> ~D) th.
axiom att_c_d.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument d_on_c : (C).
cut (~C) x.
cut (D -> ~C) th.
axiom att_d_c.
elim.
next.
axiom.
elim.
axiom.
dixi.
