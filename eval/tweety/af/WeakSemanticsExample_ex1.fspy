# WeakSemanticsExample.java (ex1): arguments a, b, c, d, e; attacks a->b, b->a, b->c, c->d, d->e, e->c
lk.
declare A, B, C, D, E : bool.
declare att_a_b : (A -> ~B).
declare att_b_a : (B -> ~A).
declare att_b_c : (B -> ~C).
declare att_c_d : (C -> ~D).
declare att_d_e : (D -> ~E).
declare att_e_c : (E -> ~C).
argument a : (A).
by default.
dixi.
argument b : (B).
by default.
dixi.
argument c : (C).
by default.
dixi.
argument d : (D).
by default.
dixi.
argument e : (E).
by default.
dixi.
counterargument a_on_b : (B).
cut (~B) x.
cut (A -> ~B) th.
axiom att_a_b.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument b_on_a : (A).
cut (~A) x.
cut (B -> ~A) th.
axiom att_b_a.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument b_on_c : (C).
cut (~C) x.
cut (B -> ~C) th.
axiom att_b_c.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument c_on_d : (D).
cut (~D) x.
cut (C -> ~D) th.
axiom att_c_d.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument d_on_e : (E).
cut (~E) x.
cut (D -> ~E) th.
axiom att_d_e.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument e_on_c : (C).
cut (~C) x.
cut (E -> ~C) th.
axiom att_e_c.
elim.
next.
axiom.
elim.
axiom.
dixi.
