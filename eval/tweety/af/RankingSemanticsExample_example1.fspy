# RankingSemanticsExample.java (example1): arguments a, b, c, d, e; attacks a->e, b->a, b->c, c->e, d->a, e->d
lk.
declare A, B, C, D, E : bool.
declare att_a_e : (A -> ~E).
declare att_b_a : (B -> ~A).
declare att_b_c : (B -> ~C).
declare att_c_e : (C -> ~E).
declare att_d_a : (D -> ~A).
declare att_e_d : (E -> ~D).
argument a : (A).
by default.
dixi.
argument b : (B).
by default.
dixi.
argument c : (C).
by default.
dixi.
argument d : (D).
by default.
dixi.
argument e : (E).
by default.
dixi.
counterargument a_on_e : (E).
cut (~E) x.
cut (A -> ~E) th.
axiom att_a_e.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument b_on_a : (A).
cut (~A) x.
cut (B -> ~A) th.
axiom att_b_a.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument b_on_c : (C).
cut (~C) x.
cut (B -> ~C) th.
axiom att_b_c.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument c_on_e : (E).
cut (~E) x.
cut (C -> ~E) th.
axiom att_c_e.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument d_on_a : (A).
cut (~A) x.
cut (D -> ~A) th.
axiom att_d_a.
elim.
next.
axiom.
elim.
axiom.
dixi.
counterargument e_on_d : (D).
cut (~D) x.
cut (E -> ~D) th.
axiom att_e_d.
elim.
next.
axiom.
elim.
axiom.
dixi.
