# Tweety lp-asp ex4.asp:
# bird(X) :- penguin(X).
# flies(X) :- bird(X), not -flies(X).
# -flies(X) :- penguin(X).
# flies(X) :- bat(X).
# :- bird(X), bat(X).
# 
# penguin(tweety).
# bat(batman).
# Translation notes:
#  - integrity constraints :- bird(batman), bat(batman); :- bird(tweety), bat(tweety) (checked on the answer sets only)
lk.
declare Bat_batman, Bird_tweety, Flies_batman, Flies_tweety, Penguin_tweety : bool.
declare r1_rule : (Penguin_tweety -> Bird_tweety).
declare r3_rule : (Bird_tweety -> (~Flies_tweety -> false) -> Flies_tweety).
declare r5_rule : (Penguin_tweety -> ~Flies_tweety).
declare r6_rule : (Bat_batman -> Flies_batman).
declare r8_rule : (Penguin_tweety).
declare r9_rule : (Bat_batman).
# r1 (strict): Penguin_tweety -> Bird_tweety
argument r1 : (Bird_tweety).
cut (Penguin_tweety -> Bird_tweety) th.
axiom r1_rule.
elim.
next.
axiom th.
dixi.
# r3 (strict): Bird_tweety -> (~Flies_tweety -> false) -> Flies_tweety
argument r3 : (Flies_tweety).
cut (Bird_tweety -> (~Flies_tweety -> false) -> Flies_tweety) th.
axiom r3_rule.
elim.
next.
elim.
elim h1.
cut (~Flies_tweety) k1.
axiom h1.
by default.
next.
axiom th.
dixi.
# r5 (strict): Penguin_tweety -> ~Flies_tweety
counterargument r5 : (Flies_tweety).
cut (~Flies_tweety) x.
cut (Penguin_tweety -> ~Flies_tweety) th.
axiom r5_rule.
elim.
next.
axiom th.
elim.
axiom.
dixi.
# r6 (strict): Bat_batman -> Flies_batman
argument r6 : (Flies_batman).
cut (Bat_batman -> Flies_batman) th.
axiom r6_rule.
elim.
next.
axiom th.
dixi.
# r8 (strict): Penguin_tweety
argument r8 : (Penguin_tweety).
axiom r8_rule.
dixi.
# r9 (strict): Bat_batman
argument r9 : (Bat_batman).
axiom r9_rule.
dixi.
