# Catala (Merigoux, Chataing, Protzenko, ICFP 2021): a scope variable has a
# base definition and exceptions that override it when their condition
# holds (prioritised default logic). Propositional instance:
#   definition rate equals 20%
#   exception definition rate under condition children >= 2 consequence equals 15%
# with children >= 2 true. Catala: rate = 15%.
# Encoding: the base definition is a bare presumption, an exception a
# derivation from its condition, the single value of a variable a strict
# exclusion between the propositions for its values.
lk.
declare Rate20, Rate15, Children : bool.
declare children : (Children).
declare exc_rule : (Children -> Rate15).
declare one_value : (Rate15 -> ~Rate20).
argument base : (Rate20).
by default.
dixi.
argument exc : (Rate15).
cut (Children -> Rate15) th.
axiom exc_rule.
elim.
axiom children.
axiom th.
dixi.
counterargument excl : (Rate20).
cut (~Rate20) x.
cut (Rate15 -> ~Rate20) th.
axiom one_value.
elim.
next.
axiom.
elim.
axiom.
dixi.
