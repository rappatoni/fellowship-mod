# Inductive generalisation (Batens' adaptive logic IL): from Pr a, Pr b
# infer forall x, Pr x unless a counter-instance is derivable; without
# a counter-instance both stand. Real
# quantifier steps (cf. tests/first_order/generalisation.fspy).
lk.
declare D : type.
declare a, b, c, d : D.
declare Pr : D -> bool.
declare pa : (Pr [a]).
declare pb : (Pr [b]).
declare not_pd : (Pr [d] -> false).
argument gen : (forall x:D, Pr [x]).
by default.
dixi.
argument pc : (Pr [c]).
cut (forall x:D, Pr [x]) r.
next.
elim [c].
axiom r.
dixi.
