meta: 
    title: "IRIS RQ 7, 7b: the scope principle as anchor"
issues: 
    i0: 
        positions:
            - correct
            - ¬correct
        standard: PE
statements: 
    proved: 
        text: the applicants have proved the change 
        label: out
    contract_missing: 
        text: the transfer agreement is not submitted 
        label: in
    demand_unmet: 
        text: a demand of the court within the scope is unmet 
        label: out
    registrable: 
        text: the entry is abstractly registrable 
        label: in
    conflict: 
        text: the register contradicts the reported change 
        label: out
    correct: 
        text: the reported change is correct 
        label: in
    duty: 
        text: the register court owes the applicants the entry 
        label: in
    passed: 
        text: the examination of the entry is passed 
        label: in
    demanded: 
        text: the court demands the transfer agreement 
        label: in
    ¬correct: 
        text: the reported change is not correct 
        label: out
    unrequired: 
        text: the law does not require the transfer agreement 
        label: in
    submitted: 
        text: the application in certified form is submitted 
        label: in
    claim: 
        text: the applicants have a claim to the entry 
        label: in
    improper: 
        text: the demand is outside the scope of examination 
        label: in
    limited: 
        text: the examination is limited to what the law requires 
        label: in
    metanorm: 
        text: "the unwritten meta-norm is in force" 
        label: in
    statute: 
        text: the entry is provided by statute 
        label: in
assumptions:
    - statute
    - submitted
    - demanded
    - contract_missing
    - unrequired
arguments: 
    bgh_limit:
        premises:
            - limited
            - unrequired
        conclusion: improper
        weight: 1.00
        scheme: linked
    scope_n7:
        conclusion: limited
        weight: 0.50
        scheme: presumption
    reg_stat:
        premises:
            - statute
        conclusion: registrable
        weight: 1.00
        scheme: linked
    corr2:
        premises:
            - claim
        conclusion: duty
        weight: 1.00
        scheme: linked
    pres_meta:
        conclusion: metanorm
        weight: 0.50
        scheme: presumption
    exam:
        premises:
            - registrable
            - submitted
            - correct
        conclusion: passed
        weight: 1.00
        scheme: linked
        undercutter: demand_unmet
    bgh_rule:
        premises:
            - claim
        conclusion: limited
        weight: 1.00
        scheme: linked
    corr1:
        premises:
            - duty
        conclusion: claim
        weight: 1.00
        scheme: linked
    face_value:
        conclusion: correct
        weight: 0.50
        scheme: presumption
    court_extra:
        premises:
            - demanded
            - contract_missing
        conclusion: demand_unmet
        scheme: presumption
        undercutter: improper
    duty_arg:
        premises:
            - metanorm
            - passed
        conclusion: duty
        weight: 1.00
        scheme: linked
