meta: 
    title: "IRIS RQ 7, 7a: the claim-scope cycle"
issues: 
    i0: 
        positions:
            - correct
            - ¬correct
        standard: PE
statements: 
    improper: the demand is outside the scope of examination
    statute: 
        text: the entry is provided by statute 
        label: in
    ¬correct: 
        text: the reported change is not correct 
        label: out
    metanorm: 
        text: "the unwritten meta-norm is in force" 
        label: in
    duty: the register court owes the applicants the entry
    registrable: 
        text: the entry is abstractly registrable 
        label: in
    claim: the applicants have a claim to the entry
    conflict: 
        text: the register contradicts the reported change 
        label: out
    passed: the examination of the entry is passed
    correct: 
        text: the reported change is correct 
        label: in
    unrequired: 
        text: the law does not require the transfer agreement 
        label: in
    demanded: 
        text: the court demands the transfer agreement 
        label: in
    limited: the examination is limited to what the law requires
    contract_missing: 
        text: the transfer agreement is not submitted 
        label: in
    demand_unmet: a demand of the court within the scope is unmet
    submitted: 
        text: the application in certified form is submitted 
        label: in
    proved: 
        text: the applicants have proved the change 
        label: out
assumptions:
    - statute
    - submitted
    - demanded
    - contract_missing
    - unrequired
arguments: 
    corr1:
        premises:
            - duty
        conclusion: claim
        scheme: linked
    corr2:
        premises:
            - claim
        conclusion: duty
        scheme: linked
    bgh_rule:
        premises:
            - claim
        conclusion: limited
        scheme: linked
    court_extra:
        premises:
            - demanded
            - contract_missing
        conclusion: demand_unmet
        scheme: presumption
        undercutter: improper
    duty_arg:
        premises:
            - metanorm
            - passed
        conclusion: duty
        scheme: linked
    pres_meta:
        conclusion: metanorm
        weight: 0.50
        scheme: presumption
    exam:
        premises:
            - registrable
            - submitted
            - correct
        conclusion: passed
        scheme: linked
        undercutter: demand_unmet
    bgh_limit:
        premises:
            - limited
            - unrequired
        conclusion: improper
        scheme: linked
    reg_stat:
        premises:
            - statute
        conclusion: registrable
        weight: 1.00
        scheme: linked
    face_value:
        conclusion: correct
        weight: 0.50
        scheme: presumption
