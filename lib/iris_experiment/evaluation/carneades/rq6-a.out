meta: 
    title: "IRIS RQ 6, 6a: complete application"
issues: 
    i0: 
        positions:
            - correct
            - ¬correct
        standard: PE
statements: 
    passed: 
        text: the examination of the entry is passed 
        label: in
    ¬correct: 
        text: the reported change is not correct 
        label: out
    proved: 
        text: the applicants have proved the change 
        label: out
    conflict: 
        text: the register contradicts the reported change 
        label: out
    metanorm: 
        text: "the unwritten meta-norm is in force" 
        label: in
    duty: 
        text: the register court owes the applicants the entry 
        label: in
    registrable: 
        text: the entry is abstractly registrable 
        label: in
    statute: 
        text: the entry is provided by statute 
        label: in
    submitted: 
        text: the application in certified form is submitted 
        label: in
    correct: 
        text: the reported change is correct 
        label: in
assumptions:
    - statute
    - submitted
arguments: 
    duty_arg:
        premises:
            - metanorm
            - passed
        conclusion: duty
        weight: 1.00
        scheme: linked
    pres_meta:
        conclusion: metanorm
        weight: 0.50
        scheme: presumption
    exam:
        premises:
            - registrable
            - submitted
            - correct
        conclusion: passed
        weight: 1.00
        scheme: linked
    reg_stat:
        premises:
            - statute
        conclusion: registrable
        weight: 1.00
        scheme: linked
    face_value:
        conclusion: correct
        weight: 0.50
        scheme: presumption
